{
  "name": "paseo-plugin-tunnel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Controlled, end-to-end encrypted HTTP service connections for trusted Paseo hosts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:files": "biome format --write",
    "format:check": "biome format .",
    "build": "node scripts/build.mjs",
    "test:file": "vitest run --bail=1 --maxWorkers=1",
    "verify:host": "tsx scripts/verify-host.mjs",
    "verify:local": "tsx scripts/verify-local.mjs",
    "preview": "tsx scripts/verify-host.mjs --ui",
    "benchmark:transport": "tsx benchmark/transport.mjs",
    "benchmark:sse": "node benchmark/anthropic-sse.mjs"
  },
  "dependencies": {
    "@getpaseo/relay": "0.6.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@getpaseo/client": "0.6.1",
    "@getpaseo/plugin": "0.6.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "@types/ws": "^8.5.8",
    "esbuild": "^0.25.0",
    "miniflare": "^4.20260730.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
