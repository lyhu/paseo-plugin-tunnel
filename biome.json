{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": ["**", "!paseo-plugin.d.ts", "!package-lock.json", "!dist"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
